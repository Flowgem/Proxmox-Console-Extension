{
  "manifest_version": 3,
  "name": "VM Console Extension",
  "version": "1.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "1024": "images/console extension logo.png"
    }
  },
  "icons": {
    "1024": "images/console extension logo.png"
  },
  "commands": {
    "paste-clipboard": {
      "suggested_key": {
        "default": "Ctrl+M",
        "windows": "Ctrl+M",
        "linux": "Ctrl+M",
        "chromeos": "Ctrl+M",
        "mac": "Command+M"
      },
      "description": "__MSG_commandDescription__"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
} 